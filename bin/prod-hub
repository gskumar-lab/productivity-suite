#!/usr/bin/env bash
# ~/.productivity-suite/bin/prod-hub
# Main Entry Point & CLI Router

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/core.sh
source "$SCRIPT_DIR/../lib/core.sh"

show_help() {
    clear
    cat << 'EOF'
Productivity Hub Helper
=======================
Usage: prod-hub [MODULE] [ARGS...]

The Hub acts as a master router. Pass arguments to a module to control it directly.
Example: prod-hub --timers countdown 15m
Example: prod-hub --tasks --add

Modules:
  -n, --notes     [args...]   Route to Integrated Notetaker
  -t, --timers    [args...]   Route to QTimer (countdown, stopwatch, pomodoro)
  -r, --routine   [args...]   Route to Daily Routine TUI
  -k, --tasks     [args...]   Route to Tasks & Checklists (Tuxedo)
  -m, --reminder  [args...]   Route to Quick Reminders daemon
  -no, --notify   [args...]   Route to Master Notifications

Global Commands:
  -q, --quicknote             Jot a quick timestamped note
  -s, --sync                  Manually force a Git sync
  -a, --autosync              Toggle automatic syncing
  -l, --logs                  View launch and sync logs
  -h, --help                  Show this help message

To see a specific module's commands, run: prod-hub <module> --help
(e.g., prod-hub -t --help)
EOF
}

toggle_autosync() {
    if [[ -f "$AUTOSYNC_FILE" ]]; then
        rm -f "$AUTOSYNC_FILE"
        notify_hub normal 3000 "Productivity Hub" "Autosync Disabled"
    else
        touch "$AUTOSYNC_FILE"
        notify_hub normal 3000 "Productivity Hub" "Autosync Enabled"
    fi
}

# ==========================================
# CLI ARGUMENT PARSING
# ==========================================
if [[ $# -gt 0 ]]; then
    case "$1" in
        -n|--notes)
            shift
            launch_and_sync "Integrated Notetaker" "$BIN_DIR/prod-notes" "$@"
            exit 0
            ;;
        -q|--quicknote)
            launch_and_sync "Quick Note" "$BIN_DIR/prod-notes" --quick
            exit 0
            ;;
        -t|--timers)
            shift
            "$BIN_DIR/prod-timers" "$@"
            exit 0
            ;;
        -r|--routine)
            shift
            if [[ "${1:-}" == "--notify" || "${1:-}" == "--status" ]]; then
                "$BIN_DIR/prod-routine" "$@"
            else
                launch_and_sync "Routine TUI" "$BIN_DIR/prod-routine" "$@"
            fi
            exit 0
            ;;
        -k|--tasks)
            shift
            "$BIN_DIR/prod-tasks" "$@"
            exit 0
            ;;
        -m|--reminder)
            shift
            "$BIN_DIR/prod-reminders" "$@"
            exit 0
            ;;
        -no|--notify)
            shift
            "$BIN_DIR/prod-notify" "$@"
            exit 0
            ;;
        -s|--sync)
            log_event "Force Sync triggered via CLI"
            sync_data >> "$LOG_FILE" 2>&1
            exit 0
            ;;
        -a|--autosync)
            toggle_autosync
            exit 0
            ;;
        -l|--logs)
            touch "$LOG_FILE"
            "$TERMINAL" -a "view-logs" -e less +G "$LOG_FILE"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Try 'prod-hub --help' for more information."
            exit 1
            ;;
    esac
fi

# ==========================================
# INTERACTIVE FUZZEL MENU
# ==========================================
while true; do
    MAIN_OPTIONS="📝 Notes\n⚡ Quick Note\n⏱️ Timers\n🔄 Routine\n✅ Tasks\n🔔 Reminder\n⚙️ Options"

    CHOICE=$(echo -e "$MAIN_OPTIONS" | fuzzel_menu "Productivity Hub ❯ " 7)

    # Exit if user presses Escape on the main menu
    [[ -z "$CHOICE" ]] && exit 0

    case "$CHOICE" in
        "📝 Notes")
            launch_and_sync "Integrated Notetaker" "$BIN_DIR/prod-notes" &
            exit 0
            ;;
        "⚡ Quick Note")
            launch_and_sync "Quick Note" "$BIN_DIR/prod-notes" --quick &
            exit 0
            ;;
        "⏱️ Timers")
            "$BIN_DIR/prod-timers" &
            exit 0
            ;;
        "🔄 Routine")
            launch_and_sync "Routine TUI" "$BIN_DIR/prod-routine" &
            exit 0
            ;;
        "✅ Tasks")
            "$BIN_DIR/prod-tasks" &
            exit 0
            ;;
        "🔔 Reminder")
            "$BIN_DIR/prod-reminders" &
            exit 0
            ;;
        "⚙️ Options")
            # Submenu Loop
            while true; do
                if [[ -f "$AUTOSYNC_FILE" ]]; then
                    AUTOSYNC_LABEL="🔄 Autosync: [ON]"
                else
                    AUTOSYNC_LABEL="🔄 Autosync: [OFF]"
                fi

                MASTER_CRON_STATUS=$("$BIN_DIR/prod-notify" --status)
                CRON_LABEL="⏰ Master Cron: [$MASTER_CRON_STATUS]"

                OPT_OPTIONS="📢 Run Master Check\n☁️ Force Sync\n$AUTOSYNC_LABEL\n$CRON_LABEL\n📄 View Logs\n❓ Help\n🔙 Back"

                OPT_CHOICE=$(echo -e "$OPT_OPTIONS" | fuzzel_menu "⚙️ Options ❯ " 7)

                # Break back to Main Menu if user presses Escape or selects Back
                [[ -z "$OPT_CHOICE" || "$OPT_CHOICE" == *"Back"* ]] && break

                case "$OPT_CHOICE" in
                    "📢 Run Master Check")
                        "$BIN_DIR/prod-notify" --run &
                        exit 0
                        ;;
                    "☁️ Force Sync")
                        log_event "Force Sync triggered manually"
                        sync_data >> "$LOG_FILE" 2>&1 &
                        disown
                        exit 0
                        ;;
                    "$AUTOSYNC_LABEL")
                        toggle_autosync
                        ;;
                    "$CRON_LABEL")
                        "$BIN_DIR/prod-notify" --toggle-cron
                        ;;
                    "📄 View Logs")
                        touch "$LOG_FILE"
                        "$TERMINAL" -a "view-logs" -e less +G "$LOG_FILE" &
                        exit 0
                        ;;
                    "❓ Help")
                        help_choice=$(echo -e "1. Hub Overview\n2. 📝 Notes Help\n3. ⏱️ Timers Help\n4. 🔄 Routine Help\n5. ✅ Tasks Help\n6. 🔔 Reminders Help\n7. 📢 Master Notify Help" | fuzzel_menu "📖 Select Manual ❯ " 7)

                        case "$help_choice" in
                            1*) cmd="$BIN_DIR/prod-hub --help" ;;
                            2*) cmd="$BIN_DIR/prod-notes --help" ;;
                            3*) cmd="$BIN_DIR/prod-timers --help" ;;
                            4*) cmd="$BIN_DIR/prod-routine --help" ;;
                            5*) cmd="$BIN_DIR/prod-tasks --help" ;;
                            6*) cmd="$BIN_DIR/prod-reminders --help" ;;
                            7*) cmd="$BIN_DIR/prod-notify --help" ;;
                            *) continue ;; # Escape out of help goes back to Options
                        esac

                        "$TERMINAL" -a "view-help" -e sh -c "$cmd ; echo ""; read -p 'Press Enter to close...' " &
                        exit 0
                        ;;
                esac
            done
            ;;
    esac
done
