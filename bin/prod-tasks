#!/usr/bin/env bash
# ~/.productivity-suite/bin/prod-tasks
# Tuxedo Tasks, Checklists, and Cron Reminders

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/core.sh
source "$SCRIPT_DIR/../lib/core.sh"

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}")"

export TODO_FILE="$TODO_DIR/todo.txt"
CHECKLIST_DIR="$TODO_DIR/checklists"
ACTIVE_CHECKLIST_DIR="$CHECKLIST_DIR/active"
mkdir -p "$TODO_DIR" "$CHECKLIST_DIR" "$ACTIVE_CHECKLIST_DIR"
touch "$TODO_FILE"

check_dependencies() {
    local deps=("tuxedo" "fzf")
    for cmd in "${deps[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            notify_hub critical 0 "Tuxedo Hub" "Dependency '$cmd' not installed."
            exit 1
        fi
    done
}

# ==========================================
# 1. CORE FOOT TUI ENGINES (fzf -m)
# ==========================================
# These run interactively inside a spawned foot terminal
if [[ "${1:-}" == "--run-checklist-tui" ]]; then
    target_file="$2"
    while true; do
        tmp_file=$(mktemp)
        grep "^\[ \]" "$target_file" > "$tmp_file" 2>/dev/null || true
        grep "^\[x\]" "$target_file" >> "$tmp_file" 2>/dev/null || true
        grep -v "^\[ \]" "$target_file" | grep -v "^\[x\]" >> "$tmp_file" 2>/dev/null || true
        mv "$tmp_file" "$target_file"

        items=$(cat -n "$target_file")
        
        selections=$(echo "$items" | fzf -m \
            --prompt="❯ Checklist (ESC to save): " \
            --header="TAB: multi-select | ENTER: toggle selected | ESC: save & exit" \
            --layout=reverse --height=100% --border)
        
        [[ -z "$selections" ]] && break
        
        while IFS= read -r selection; do
            line_num=$(echo "$selection" | awk '{print $1}')
            if sed -n "${line_num}p" "$target_file" | grep -q "\[ \]"; then
                sed -i "${line_num}s/\[ \]/\[x\]/" "$target_file"
            elif sed -n "${line_num}p" "$target_file" | grep -q "\[x\]"; then
                sed -i "${line_num}s/\[x\]/\[ \]/" "$target_file"
            fi
        done <<< "$selections"
    done
    exit 0
fi

if [[ "${1:-}" == "--run-export-tui" ]]; then
    target_file="$2"
    base_name="$3"
    unchecked=$(grep "^\[ \]" "$target_file" | sed -e 's/^\[ \] //' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/\r//')
    
    selected_tasks=$(echo "$unchecked" | fzf -m \
        --prompt="❯ Select tasks to export: " \
        --header="TAB: multi-select | ENTER: export | ESC: cancel" \
        --layout=reverse --height=100%)
    
    if [[ -n "$selected_tasks" ]]; then
        while IFS= read -r task; do
            tuxedo add "$task +checklist @$base_name" >/dev/null
        done <<< "$selected_tasks"
        echo -e "\n\033[1;32m✔ Exported selected tasks to Tuxedo!\033[0m"
        sleep 1.5
    fi
    exit 0
fi

# ==========================================
# 2. QUICK ADD & MENUS (Fuzzel)
# ==========================================
add_quick_todo() {
    local task prio
    task=$(fuzzel_input "Quick Task (+project @context due:YYYY-MM-DD) ❯ ")
    [[ -z "${task// /}" ]] && return

    prio=$(fuzzel_input "Priority (A-Z, leave blank for none) ❯ ")
    prio=$(echo "$prio" | tr 'a-z' 'A-Z' | grep -o '^[A-Z]$' || true)

    if [[ -n "$prio" ]]; then
        task="($prio) $task"
    fi

    tuxedo add "$task" >/dev/null
    notify_hub normal 2000 "Tuxedo" "Task added successfully!"
    trigger_autosync "quick-todo"
}

checklists_menu() {
    while true; do
        local options choice
        options="1. Start New Checklist from Template\n2. Create New Blank Checklist\n3. Resume Active Checklist\n4. Send Unchecked Items to Tuxedo\n5. Delete Active Checklist\n6. Back"
        choice=$(echo -e "$options" | fuzzel_menu "☑️ Checklists ❯ " 6)
        [[ -z "$choice" || "$choice" == *"Back"* ]] && return

        case "$choice" in
            1*)
                local templates template base_name new_active
                templates=$(ls -1 "$CHECKLIST_DIR"/*.txt 2>/dev/null || true)
                [[ -z "$templates" ]] && { notify_hub normal 2000 "Checklists" "No templates found."; continue; }
                template=$(echo "$templates" | xargs -n 1 basename | fuzzel_menu "Select Template ❯ " 10)
                [[ -z "$template" ]] && continue
                base_name=$(basename "$template" .txt)
                new_active="$ACTIVE_CHECKLIST_DIR/${base_name}_$(date +%Y%m%d_%H%M).txt"
                cp "$CHECKLIST_DIR/$template" "$new_active"
                launch_and_sync "tuxedo-checklist" "$SCRIPT_PATH" --run-checklist-tui "$new_active"
                ;;
            2*)
                local cl_name safe_name new_active
                cl_name=$(fuzzel_input "New Checklist Name ❯ ")
                [[ -z "${cl_name// /}" ]] && continue
                safe_name=$(echo "$cl_name" | tr ' ' '_')
                new_active="$ACTIVE_CHECKLIST_DIR/${safe_name}_$(date +%Y%m%d_%H%M).txt"
                
                # Open editor in terminal
                "$TERMINAL" -a "tuxedo-checklist" -e "$EDITOR" "$new_active"
                
                if [[ -f "$new_active" ]]; then
                    sed -i -e '/^$/d' -e '/^\[[ x]\]/! s/^/[ ] /' "$new_active"
                    launch_and_sync "tuxedo-checklist" "$SCRIPT_PATH" --run-checklist-tui "$new_active"
                fi
                ;;
            3*)
                local actives active_file full_path
                actives=$(ls -1 "$ACTIVE_CHECKLIST_DIR"/*.txt 2>/dev/null || true)
                [[ -z "$actives" ]] && { notify_hub normal 2000 "Checklists" "No active checklists."; continue; }
                active_file=$(echo "$actives" | xargs -n 1 basename | fuzzel_menu "Resume Active ❯ " 10)
                [[ -z "$active_file" ]] && continue
                full_path="$ACTIVE_CHECKLIST_DIR/$active_file"
                launch_and_sync "tuxedo-checklist" "$SCRIPT_PATH" --run-checklist-tui "$full_path"
                ;;
            4*)
                local actives active_file full_path base_name unchecked
                actives=$(ls -1 "$ACTIVE_CHECKLIST_DIR"/*.txt 2>/dev/null || true)
                [[ -z "$actives" ]] && { notify_hub normal 2000 "Checklists" "No active checklists."; continue; }
                active_file=$(echo "$actives" | xargs -n 1 basename | fuzzel_menu "Export from ❯ " 10)
                [[ -z "$active_file" ]] && continue
                full_path="$ACTIVE_CHECKLIST_DIR/$active_file"
                
                base_name=$(basename "$active_file" | cut -d'_' -f1)
                unchecked=$(grep "^\[ \]" "$full_path" | sed -e 's/^\[ \] //' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/\r//' || true)
                
                if [[ -z "$unchecked" ]]; then
                    notify_hub normal 2000 "Checklists" "No unchecked items found."
                    continue
                fi
                
                launch_and_sync "tuxedo-checklist" "$SCRIPT_PATH" --run-export-tui "$full_path" "$base_name"
                ;;
            5*)
                local actives active_file full_path confirm
                actives=$(ls -1 "$ACTIVE_CHECKLIST_DIR"/*.txt 2>/dev/null || true)
                [[ -z "$actives" ]] && continue
                active_file=$(echo "$actives" | xargs -n 1 basename | fuzzel_menu "Delete Checklist ❯ " 10)
                [[ -z "$active_file" ]] && continue
                full_path="$ACTIVE_CHECKLIST_DIR/$active_file"
                
                confirm=$(echo -e "Yes\nNo" | fuzzel_menu "Delete $active_file? ❯ " 2)
                if [[ "$confirm" == "Yes" ]]; then
                    rm -f "$full_path"
                    notify_hub normal 2000 "Checklists" "Deleted $active_file."
                    trigger_autosync "checklist-delete"
                fi
                ;;
        esac
    done
}

# ==========================================
# 3. CRON NOTIFICATIONS & TOGGLES
# ==========================================
check_reminders() {
    local mode=$1
    local task_count=0
    local title=""
    local message=""
    
    [[ ! -f "$TODO_FILE" ]] && return 0
    
    local pending_tasks
    pending_tasks=$(grep -v '^x ' "$TODO_FILE" || true)
    [[ -z "$pending_tasks" ]] && return 0

    if [[ "$mode" == "today" ]]; then
        local today_date
        today_date=$(date +%Y-%m-%d)
        task_count=$(echo "$pending_tasks" | grep -c "due:$today_date" || true)
        title="Tasks Due Today"
        message="You have $task_count task(s) due today."
        
    elif [[ "$mode" == "overdue" ]]; then
        local today_epoch
        today_epoch=$(date -d "$(date +%Y-%m-%d)" +%s)
        
        while read -r line; do
            local due_date
            due_date=$(echo "$line" | grep -o 'due:[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' | cut -d':' -f2 || true)
            if [[ -n "$due_date" ]]; then
                local due_epoch
                due_epoch=$(date -d "$due_date" +%s 2>/dev/null || echo "")
                if [[ -n "$due_epoch" && "$due_epoch" -lt "$today_epoch" ]]; then
                    ((task_count++))
                fi
            fi
        done <<< "$(echo "$pending_tasks" | grep 'due:' || true)"
        
        title="Overdue Tasks"
        message="You have $task_count overdue task(s)."
    fi

    if [[ "$task_count" -gt 0 ]]; then
        if command -v notify-send >/dev/null 2>&1; then
            local action
            action=$(notify-send -e -t 0 "$title" "$message" \
                --action="open=Open Tuxedo" \
                --action="dismiss=Dismiss" \
                --icon=appointment-soon)

            if [[ "$action" == "open" ]]; then
                launch_and_sync "tuxedo-wrapper" "tuxedo" "$TODO_FILE" &
                disown
            fi
        fi
    fi
}

manage_cron_toggle() {
    local backup_file="/tmp/crontab_backup_$(date +%s).bak"
    crontab -l > "$backup_file" 2>/dev/null || true
    
    local mode=$1
    local tag_today="# TUXEDO_WRAPPER_CRON_TODAY"
    local tag_overdue="# TUXEDO_WRAPPER_CRON_OVERDUE"
    
    if [[ "$mode" == "today" ]]; then
        if crontab -l 2>/dev/null | grep -q "$tag_today"; then
            (crontab -l 2>/dev/null | grep -v "$tag_today") | crontab -
            notify_hub normal 3000 "Cron Reminders" "Today's reminders disabled."
        else
            (crontab -l 2>/dev/null | grep -v "$tag_today"; echo "0 */4 * * * $SCRIPT_PATH --reminders-today $tag_today") | crontab -
            notify_hub normal 3000 "Cron Reminders" "Today's reminders enabled (daily - every 4 hrs)."
        fi
    elif [[ "$mode" == "overdue" ]]; then
        if crontab -l 2>/dev/null | grep -q "$tag_overdue"; then
            (crontab -l 2>/dev/null | grep -v "$tag_overdue") | crontab -
            notify_hub normal 3000 "Cron Reminders" "Overdue reminders disabled."
        else
            (crontab -l 2>/dev/null | grep -v "$tag_overdue"; echo "0 */4 * * * $SCRIPT_PATH --reminders-overdue $tag_overdue") | crontab -
            notify_hub normal 3000 "Cron Reminders" "Overdue reminders enabled (every 4 hrs)."
        fi
    fi
    sleep 1.5
}

reminders_menu() {
    while true; do
        local today_status="OFF" overdue_status="OFF"
        
        crontab -l 2>/dev/null | grep -q "# TUXEDO_WRAPPER_CRON_TODAY" && today_status="ON"
        crontab -l 2>/dev/null | grep -q "# TUXEDO_WRAPPER_CRON_OVERDUE" && overdue_status="ON"

        local options="1. Run Current Day Reminders Now\n2. Run Overdue Reminders Now\n3. Toggle Auto: Today ($today_status)\n4. Toggle Auto: Overdue ($overdue_status)\n5. Back"
        local choice
        choice=$(echo -e "$options" | fuzzel_menu "🔔 Cron Reminders ❯ " 5)

        [[ -z "$choice" || "$choice" == *"Back"* ]] && return

        case "$choice" in
            1*) check_reminders "today" ;;
            2*) check_reminders "overdue" ;;
            3*) manage_cron_toggle "today" ;;
            4*) manage_cron_toggle "overdue" ;;
        esac
    done
}

# ==========================================
# 4. CLI ARGUMENTS & MAIN ROUTER
# ==========================================
check_dependencies

if [[ $# -gt 0 ]]; then
    case "$1" in
        -l|--launch)              launch_and_sync "tuxedo-wrapper" "tuxedo" "$TODO_FILE" ;;
        -a|--add)                 add_quick_todo ;;
        -c|--checklists)          checklists_menu ;;
        -rt|--reminders-today)    check_reminders "today" ;;
        -ro|--reminders-overdue)  check_reminders "overdue" ;;
        -h|--help)
            echo -e "Usage: prod-tasks [OPTIONS]\n\n  -l, --launch\n  -a, --add\n  -c, --checklists\n  -rt, --reminders-today\n  -ro, --reminders-overdue"
            exit 0
            ;;
        *) echo "Invalid option."; exit 1 ;;
    esac
else
    while true; do
        options="1. 🖥️ Launch Tuxedo TUI\n2. ➕ Add Quick Todo\n3. ☑️ Checklists Menu\n4. 🔔 Reminders & Cron\n5. ❌ Exit"
        choice=$(echo -e "$options" | fuzzel_menu "✅ Tasks & Checklists ❯ " 5)

        [[ -z "$choice" || "$choice" == *"Exit"* ]] && exit 0

        case "$choice" in
            1*) launch_and_sync "tuxedo-wrapper" "tuxedo" "$TODO_FILE" ;;
            2*) add_quick_todo ;;
            3*) checklists_menu ;;
            4*) reminders_menu ;;
        esac
    done
fi

