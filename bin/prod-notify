#!/usr/bin/env bash
# ~/.productivity-suite/bin/prod-notify
# Unified Startup, Cron Notification Dispatcher & Master Reminders

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/core.sh
source "$SCRIPT_DIR/../lib/core.sh"

show_help() {
    cat << 'EOF'
Master Notifications Helper
===========================
Usage: prod-notify [OPTIONS]

Options:
  --run           Run all master notifications now (Tasks, Routine)
  --startup       Run startup sequence (sleeps 5s first)
  --toggle-cron   Toggle the 4-hourly master cron job
  --status        Output 'ON' or 'OFF' for master cron status
  -h, --help      Show this help message
EOF
}

run_all() {
    log_event "prod-notify: Dispatching master notifications."
    "$BIN_DIR/prod-tasks" --reminders-overdue
    "$BIN_DIR/prod-tasks" --reminders-today
    "$BIN_DIR/prod-routine" --notify
    log_event "prod-notify: Initiating background autosync."
    sync_data > "$SYNC_LOG" 2>&1 &
    disown
}

toggle_cron() {
    local backup_file="/tmp/crontab_backup_$(date +%s).bak"
    crontab -l > "$backup_file" 2>/dev/null || true

    local tag="# PRODUCTIVITY_HUB_MASTER_CRON"
    if crontab -l 2>/dev/null | grep -q "$tag"; then
        (crontab -l 2>/dev/null | grep -v "$tag") | crontab -
        notify_hub normal 3000 "Master Reminders" "Automated master reminders DISABLED."
    else
        (crontab -l 2>/dev/null | grep -v "$tag"; echo "0 */4 * * * $BIN_DIR/prod-notify --run $tag") | crontab -
        notify_hub normal 3000 "Master Reminders" "Automated master reminders ENABLED (every 4 hrs)."
    fi
}

check_status() {
    if crontab -l 2>/dev/null | grep -q "# PRODUCTIVITY_HUB_MASTER_CRON"; then
        echo "ON"
    else
        echo "OFF"
    fi
}

if [[ $# -gt 0 ]]; then
    case "$1" in
        --run)         run_all; exit 0 ;;
        --startup)     sleep 5; run_all; exit 0 ;;
        --toggle-cron) toggle_cron; exit 0 ;;
        --status)      check_status; exit 0 ;;
        -h|--help)     show_help; exit 0 ;;
        *)             echo "Unknown option. Use --help" >&2; exit 1 ;;
    esac
else
    run_all
fi
